# Defaults for landau phase diagrams.
#
# Every plot function in landau.plot applies these for the duration of its call
# to each key still at matplotlib's built-in default (landau.plot.style.styled);
# whatever the caller has set wins. Load the sheet globally to also cover axes
# and figures created outside the plot calls, and savefig:
#
#     import matplotlib.pyplot as plt
#     plt.style.use("landau.plot.landau")

lines.linewidth / lines.markersize and its text relative to font.size, so
# the values here (or the user's own rcParams) govern all of them alike.

lines.linewidth: 2.0
lines.markersize: 6.0

font.size: 10.0
axes.titlesize: medium
axes.labelsize: medium
xtick.labelsize: small
ytick.labelsize: small
legend.fontsize: small
legend.frameon: False

figure.figsize: 6.0, 4.5
figure.dpi: 100
savefig.dpi: 150
savefig.bbox: tight
