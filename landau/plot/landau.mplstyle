# Figure-level defaults for landau phase diagrams.
#
#     import matplotlib.pyplot as plt
#     plt.style.use("landau.plot.landau")
#
# Every plot function in landau.plot sizes its lines and markers from
# lines.linewidth / lines.markersize and its text relative to font.size, so
# the values here (or the user's own rcParams) govern all of them alike.

lines.linewidth: 2.0
lines.markersize: 6.0

font.size: 10.0
axes.titlesize: medium
axes.labelsize: medium
xtick.labelsize: small
ytick.labelsize: small
legend.fontsize: small
legend.frameon: False

figure.figsize: 6.0, 4.5
figure.dpi: 100
savefig.dpi: 150
savefig.bbox: tight
